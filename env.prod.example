# Copy to .env.prod and fill in real values. Never commit .env.prod.

SECRET_KEY=change-me-to-a-long-random-value

# ── Host port registry for zahidulturja.com ────────────────────────────────
# Keep this comment block updated as you add projects, so you never have to
# guess-and-check for a free port. All app-level ports are bound to
# 127.0.0.1 only; nothing here needs to be reachable except via Nginx or an
# SSH tunnel.
#
#   80/443   Nginx (host, not containerized)
#   22       SSH (via Cloudflare Tunnel ssh.zahidulturja.com)
#   8080     CasaOS
#   8097     Jellyfin
#   2283     Immich
#   8765     GhorKhojee (uvicorn, in ghorkhojee_web container)
#   8766     TinyTeemo app        <- APP_PORT below
#   5555     TinyTeemo Flower     <- FLOWER_PORT below (opt-in profile, loopback/SSH-tunnel only)
#
#   Next free block for a future project: 8767+
#
APP_PORT=8766
FLOWER_PORT=5555
